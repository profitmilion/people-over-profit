{
  "name": "@pop33/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reproducible Hardhat workspace for the POP33 Basic V1 contracts",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:dry-run": "hardhat run scripts/deploy-local.ts",
    "deploy:base-sepolia": "hardhat run scripts/deploy-base-sepolia.ts --network baseSepolia",
    "deploy:base-sepolia:external-token": "hardhat run scripts/deploy-base-sepolia.ts --network baseSepolia",
    "deploy:base-sepolia:demo-token": "hardhat run scripts/deploy-base-sepolia-demo-token.ts --network baseSepolia",
    "verify:base-sepolia:demo-token": "hardhat verify etherscan --build-profile default --network baseSepoliaVerify --contract contracts/Pop33DemoUSDC.sol:Pop33DemoUSDC 0xA7FA084b34c888061757d4b5FBb08a7B53fee786 330000000 86400",
    "verify:base-sepolia:pop33": "hardhat verify etherscan --build-profile default --network baseSepoliaVerify --contract contracts/Pop33BasicV1.sol:Pop33BasicV1 0x140DA1b29F0B00b003Cabe86AE1a473d6745f56F 0xA7FA084b34c888061757d4b5FBb08a7B53fee786 3600",
    "smoke:demo-v1": "hardhat run scripts/smoke-demo-v1.ts",
    "operator:local:lifecycle": "hardhat run scripts/operator-local-lifecycle.ts",
    "smoke:base-sepolia": "node scripts/base-sepolia-smoke-cli.mjs",
    "operator:base-sepolia:read-only": "node scripts/base-sepolia-read-only-operator-cli.mjs",
    "operator:base-sepolia:init-pilot-5": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/initialize-base-sepolia-pilot-5.ps1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.14",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.0.21",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-verify": "3.0.21",
    "@openzeppelin/contracts": "5.6.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.9.1",
    "mocha": "11.7.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.10.0"
  }
}

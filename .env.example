# Legacy frontend/prototype configuration retained for compatibility. The
# contract address is still read by the legacy on-chain hook and is not the
# current Pilot 10 contract. The RPC value is still a wagmi fallback, the three
# timing values are still read by the local simulation, and
# VITE_POP33_CHAIN_ID currently has no source-code reader.
VITE_POP33_CONTRACT_ADDRESS=0x9f55436afeb8B8F8E1495bD0Cd6052e233FBc966
VITE_POP33_CHAIN_ID=84532
VITE_POP33_RPC_URL=https://sepolia.base.org
VITE_DEMO_DRAW_INTERVAL_MS=
VITE_DEMO_FIRST_DRAW_DELAY_MS=
VITE_DEMO_MAX_AUTO_DRAWS_PER_CYCLE=
# POP33 Public Pilot 10 — active Base Sepolia Mini App deployment
VITE_POP33_DEMO_V1_CONTRACT_ADDRESS=0xc2fAA10d3E5FEeB88604dc3A1Ab33656fFeBCA98
VITE_POP33_DEMO_V1_TOKEN_ADDRESS=0xA7FA084b34c888061757d4b5FBb08a7B53fee786
VITE_POP33_DEMO_V1_CHAIN_ID=84532
VITE_POP33_DEMO_V1_RPC_URL=https://sepolia.base.org
# Public temporary cutover. Manual Draw is disabled unless explicitly true.
VITE_POP33_MANUAL_DRAW_ENABLED=false
# Public address is required for Draw simulation because executeDraw uses msg.sender.
BASE_SEPOLIA_DRAW_OPERATOR_ADDRESS=
# Primary endpoint for lifecycle supervisor and guarded Draw reads.
BASE_SEPOLIA_SUPERVISOR_RPC_URL=https://sepolia.base.org
# Optional independent Base Sepolia provider used only for guarded read failover.
BASE_SEPOLIA_SUPERVISOR_RPC_URL_FALLBACK=
# Execute-only; never pass this value as a CLI argument or use it for inspect/simulate.
BASE_SEPOLIA_DRAW_OPERATOR_PRIVATE_KEY=
# Public operator guard used during the controlled automatic one-shot window.
POP33_AUTOMATIC_DRAW_LIVE_TEST_ACTIVE=false
# Public durable artifact locations and revisions printed by prepare.
POP33_INTERNAL_AUTOMATIC_DRAW_STATE_PATH=
OPERATOR_TRANSACTION_JOURNAL_PATH=
POP33_INTERNAL_AUTOMATIC_DRAW_PROGRESSION_REVISION=
POP33_INTERNAL_AUTOMATIC_DRAW_JOURNAL_REVISION=

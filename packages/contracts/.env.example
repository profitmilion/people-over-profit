# Base Sepolia deployment only. Hardhat reads these values from the process
# environment; this example file is documentation and is not loaded automatically.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Existing external-token deployment variant only.
BASE_SEPOLIA_USDC_ADDRESS=

# Demo V1 constructor parameter. The deployment script requires exactly 3600.
POP33_DEMO_DRAW_INTERVAL_SECONDS=3600

# Keep empty until a reviewed deployment is intentionally authorized.
# Required phrase: DEPLOY_POP33_DEMO_V1
POP33_BASE_SEPOLIA_DEPLOY_CONFIRM=

# POP33-owned demo-token pair variant. Values are fixed for Demo V1.
POP33_DEMO_DRIP_AMOUNT_UNITS=330000000
POP33_DEMO_DRIP_COOLDOWN_SECONDS=86400

# Keep both empty until each reviewed public write is intentionally authorized.
# Required phrases:
# DEPLOY_POP33_DEMO_TOKEN
# DEPLOY_POP33_DEMO_V1_WITH_DEMO_TOKEN
POP33_BASE_SEPOLIA_TOKEN_DEPLOY_CONFIRM=
POP33_BASE_SEPOLIA_POP33_DEPLOY_CONFIRM=

# Optional for a future separate explorer-verification command. Not used by deployment.
BASESCAN_API_KEY=
